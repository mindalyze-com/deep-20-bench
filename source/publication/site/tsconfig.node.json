{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "types": ["node", "@playwright/test"],
    "skipLibCheck": true
  },
  "include": [
    "vite.config.ts",
    "static-home.ts",
    "playwright.config.ts",
    "tests/**/*.ts",
    "src/lib/confidence-width.ts"
  ]
}
