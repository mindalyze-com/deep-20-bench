{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "source/publication/site",
        "run",
        "dev",
        "--",
        "--port",
        "5310",
        "--strictPort"
      ],
      "port": 5310
    },
    {
      "name": "docs-preview",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DEEP20_OUTPUT_DIR=../../../docs",
        "npm",
        "--prefix",
        "source/publication/site",
        "run",
        "preview",
        "--",
        "--host",
        "127.0.0.1",
        "--port",
        "4180",
        "--strictPort"
      ],
      "port": 4180
    }
  ]
}
