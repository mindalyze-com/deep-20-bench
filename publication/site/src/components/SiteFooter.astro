---
import { sourceRepositoryUrl } from "../lib/project-links";

const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div>
    <p class="eyebrow">Deep20Bench</p>
    <p class="footer-statement">
      Can an LLM ask its way to the answer?
    </p>
  </div>
  <div class="footer-links">
    <a href={`${base}methodology/`}>Method</a>
    <a href={`${base}story/`}>Story & prior work</a>
    <a href={`${base}data/`}>Data</a>
    <a href={sourceRepositoryUrl} target="_blank" rel="noreferrer">Source code ↗</a>
  </div>
  <p class="footer-fineprint">
    Patrick Heusser and Markus Tuor came up with the idea together. Patrick designed and built
    Deep20Bench. This site is generated from completed run files in the linked source
    repository. It makes no model calls.
  </p>
</footer>
