---
import { dataset, number } from "../lib/data";

interface Props {
  score: string | null;
  penalizedQuestions?: string | null;
  maxQuestions?: number;
  status?: "auto" | "success" | "model_failure" | "infrastructure_failure";
  label?: string;
  showLabel?: boolean;
  variant?: "full" | "compact" | "metric" | "hero";
  explain?: boolean;
  theme?: "light" | "dark";
}

const {
  score,
  penalizedQuestions = null,
  maxQuestions = dataset.active_cohort.max_questions,
  status = "auto",
  label = "B20 Score",
  showLabel = true,
  variant = "full",
  explain = false,
  theme = "light",
} = Astro.props;

const target = dataset.score_policy.b20.target_questions;
const failurePenalty = maxQuestions + dataset.score_policy.failure_penalty_offset;
const maximum = (target * failurePenalty) / (failurePenalty - target);
const numericScore = score === null ? null : Number(score);
const position =
  numericScore === null ? 0 : Math.max(0, Math.min(100, (numericScore / maximum) * 100));
const targetPosition = (target / maximum) * 100;
const state =
  status === "infrastructure_failure" || numericScore === null
    ? "unavailable"
    : status === "model_failure"
      ? "failed"
      : numericScore > target
        ? "above"
        : numericScore < target
          ? "below"
          : "target";
const stateLabel = {
  above: "Above target",
  target: "On target",
  below: "Below target",
  failed: "Failed",
  unavailable: "Not scored",
}[state];
const accessibleValue =
  numericScore === null
    ? `${label}: not scored`
    : `${label}: ${number(score, 1)}, ${stateLabel.toLowerCase()}`;
const distanceFromTarget =
  numericScore === null ? null : Math.abs(numericScore - target);
---

<div
  class:list={[
    "b20-score",
    `b20-${state}`,
    `b20-variant-${variant}`,
    theme === "dark" && "b20-dark",
  ]}
  style={`--b20-position:${position}%;--b20-target:${targetPosition}%`}
>
  {
    variant !== "metric" && (
      <>
        {
          showLabel && (
            <div class="b20-heading">
              <span>{label}</span>
              {
                explain && (
                  <details class="b20-help">
                    <summary aria-label="Explain the B20 Score">i</summary>
                    <div class="b20-help-copy">
                      <strong>B20 Score</strong>
                      <p>
                        Higher is better. A score of {target} means {target} penalized questions.
                        A failure scores zero. Infrastructure failures are not scored.
                      </p>
                      <code>
                        {target} × ({failurePenalty} − penalized questions) ÷{" "}
                        {failurePenalty - target}
                      </code>
                    </div>
                  </details>
                )
              }
            </div>
          )
        }

        <div class="b20-value-line">
          <strong>{number(score, 1)}</strong>
          <span>{stateLabel}</span>
        </div>
      </>
    )
  }

  {
    variant === "metric" && (
      <span class="b20-metric-value">{number(score, 1)}</span>
    )
  }

  {
    variant !== "compact" && (
      <>
        <div
          class="b20-scale"
          role="img"
          aria-label={`${accessibleValue}. The target marker is ${target}.`}
        >
          <span class="b20-fill"></span>
          <i class="b20-target-line" aria-hidden="true"></i>
          {numericScore !== null && <i class="b20-marker" aria-hidden="true"></i>}
        </div>
        {
          variant === "full" && (
            <div class="b20-scale-labels" aria-hidden="true">
              <span>0</span>
              <span style={`left:${targetPosition}%`}>{target} target</span>
              <span>{number(maximum, 1)}</span>
            </div>
          )
        }
      </>
    )
  }

  {
    variant === "hero" &&
      distanceFromTarget !== null &&
      (state === "above" || state === "below" || state === "target") && (
      <p class="b20-delta">
        {
          state === "target" ? (
            <>On the <strong>{target}-point</strong> target</>
          ) : state === "above" || state === "below" ? (
            <>
              <strong>{number(distanceFromTarget, 1)}</strong> points {state} target
            </>
          ) : null
        }
      </p>
    )
  }

  {
    variant !== "metric" && penalizedQuestions !== null && (
      <p class="b20-raw">{number(penalizedQuestions)} penalized questions</p>
    )
  }
</div>

<style>
  .b20-score {
    --b20-tone: var(--blue);
    min-width: 0;
  }

  .b20-heading {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: inherit;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .b20-help {
    position: relative;
  }

  .b20-help summary {
    display: grid;
    width: 1.25rem;
    height: 1.25rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    cursor: pointer;
    font-family: Georgia, serif;
    font-size: 0.72rem;
    font-style: italic;
    letter-spacing: 0;
    list-style: none;
    place-items: center;
    text-transform: none;
  }

  .b20-help summary::-webkit-details-marker {
    display: none;
  }

  .b20-help summary:focus-visible {
    outline: 3px solid var(--acid);
    outline-offset: 3px;
  }

  .b20-help-copy {
    position: absolute;
    z-index: 30;
    top: calc(100% + 0.65rem);
    left: 0;
    width: min(22rem, calc(100vw - 2rem));
    padding: 1rem;
    border: 1px solid var(--ink);
    background: var(--paper-bright);
    box-shadow: 0 1.25rem 3rem rgb(17 19 28 / 18%);
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.55;
    text-transform: none;
  }

  .b20-help-copy strong {
    font-size: 0.78rem;
  }

  .b20-help-copy p {
    margin: 0.55rem 0 0.75rem;
    color: var(--muted);
  }

  .b20-help-copy code {
    display: block;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    overflow-wrap: anywhere;
    font-size: 0.69rem;
  }

  .b20-value-line {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-top: 0.55rem;
  }

  .b20-value-line strong {
    color: var(--b20-tone);
    font-family: Iowan Old Style, "Palatino Linotype", Georgia, serif;
    font-size: clamp(2.3rem, 5vw, 4.4rem);
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .b20-value-line span {
    color: var(--b20-tone);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .b20-scale {
    position: relative;
    height: 0.42rem;
    margin-top: 1rem;
    background: #dedbd2;
  }

  .b20-metric-value {
    display: block;
    font-variant-numeric: tabular-nums;
  }

  .b20-variant-metric .b20-scale {
    height: 0.3rem;
    margin-top: 0.55rem;
  }

  .b20-variant-metric .b20-target-line {
    top: -0.25rem;
    bottom: -0.25rem;
    width: 1px;
  }

  .b20-variant-metric .b20-marker {
    width: 0.65rem;
    height: 0.65rem;
    border-width: 1px;
  }

  .b20-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--b20-position);
    background: var(--b20-tone);
  }

  .b20-target-line {
    position: absolute;
    top: -0.35rem;
    bottom: -0.35rem;
    left: var(--b20-target);
    width: 2px;
    background: var(--b20-line, var(--ink));
  }

  .b20-marker {
    position: absolute;
    top: 50%;
    left: var(--b20-position);
    width: 0.85rem;
    height: 0.85rem;
    border: 2px solid var(--paper-bright);
    border-radius: 50%;
    background: var(--b20-tone);
    box-shadow: 0 0 0 1px var(--ink);
    transform: translate(-50%, -50%);
  }

  .b20-scale-labels {
    position: relative;
    display: flex;
    justify-content: space-between;
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.59rem;
    font-variant-numeric: tabular-nums;
  }

  .b20-scale-labels span:nth-child(2) {
    position: absolute;
    font-weight: 750;
    transform: translateX(-50%);
  }

  .b20-raw {
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
  }

  .b20-delta {
    margin: 1.45rem 0 0;
    font-family: Iowan Old Style, "Palatino Linotype", Georgia, serif;
    font-size: clamp(1.35rem, 2vw, 2rem);
    letter-spacing: -0.025em;
  }

  .b20-delta strong {
    color: var(--b20-tone);
    font-size: 1.35em;
    font-weight: 500;
  }

  .b20-below,
  .b20-failed {
    --b20-tone: #b83f24;
  }

  .b20-target {
    --b20-tone: var(--ink);
  }

  .b20-unavailable {
    --b20-tone: var(--muted);
  }

  .b20-dark {
    --b20-line: white;
  }

  .b20-dark.b20-above {
    --b20-tone: var(--acid);
  }

  .b20-dark.b20-target,
  .b20-dark.b20-unavailable {
    --b20-tone: white;
  }

  .b20-dark .b20-scale {
    background: rgb(255 255 255 / 18%);
  }

  .b20-dark .b20-marker {
    border-color: var(--ink);
    box-shadow: 0 0 0 1px white;
  }

  .b20-dark .b20-scale-labels,
  .b20-dark .b20-raw {
    color: rgb(255 255 255 / 58%);
  }

  .b20-variant-hero .b20-heading {
    font-size: 0.71rem;
    letter-spacing: 0.16em;
  }

  .b20-variant-hero .b20-value-line {
    gap: 1.25rem;
    justify-content: space-between;
    margin-top: 1.1rem;
  }

  .b20-variant-hero .b20-value-line strong {
    font-size: clamp(7rem, 12vw, 11rem);
    letter-spacing: -0.085em;
    line-height: 0.75;
  }

  .b20-variant-hero .b20-value-line span {
    max-width: 9rem;
    margin-bottom: 0.2rem;
    font-size: 0.73rem;
    line-height: 1.3;
    text-align: right;
  }

  .b20-variant-hero .b20-scale {
    height: 0.34rem;
    margin-top: 1.7rem;
  }

  .b20-variant-hero .b20-scale-labels {
    margin-top: 0.6rem;
    font-size: 0.65rem;
  }

  .b20-variant-hero .b20-raw {
    margin-top: 1rem;
    font-size: 0.75rem;
  }

  .b20-unavailable .b20-scale {
    background: repeating-linear-gradient(
      -45deg,
      #dedbd2,
      #dedbd2 4px,
      transparent 4px,
      transparent 8px
    );
  }

  .b20-variant-compact .b20-heading {
    font-size: 0.59rem;
  }

  .b20-variant-compact .b20-value-line {
    display: block;
    margin-top: 0.25rem;
  }

  .b20-variant-compact .b20-value-line strong {
    font-family: inherit;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .b20-variant-compact .b20-value-line span {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.54rem;
  }

  .b20-variant-compact .b20-raw {
    margin-top: 0.35rem;
    font-size: 0.63rem;
  }

  @media (max-width: 640px) {
    .b20-variant-hero .b20-value-line {
      display: block;
    }

    .b20-variant-hero .b20-value-line strong {
      font-size: clamp(6rem, 32vw, 9rem);
    }

    .b20-variant-hero .b20-value-line span {
      display: block;
      max-width: none;
      margin: 1.25rem 0 0;
      text-align: left;
    }

    .b20-help {
      position: static;
    }

    .b20-help-copy {
      position: static;
      width: auto;
      margin-top: 0.75rem;
    }

    .b20-heading:has(.b20-help[open]) {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .b20-heading:has(.b20-help[open]) .b20-help {
      flex-basis: 100%;
    }
  }
</style>
