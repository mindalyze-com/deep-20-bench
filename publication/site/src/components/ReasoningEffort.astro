---
import { reasoningEffortLabel } from "../lib/data";

interface Props {
  effort: string;
  theme?: "light" | "dark";
  compact?: boolean;
}

const { effort, theme = "light", compact = false } = Astro.props;
const normalizedEffort = effort.trim().toLowerCase().replaceAll("_", "-");
const activeSteps =
  {
    none: 0,
    minimal: 1,
    low: 1,
    medium: 2,
    high: 3,
    "extra-high": 3,
    xhigh: 3,
    max: 3,
  }[normalizedEffort] ?? 0;
const label = reasoningEffortLabel(effort);
---

<span
  class:list={[
    "reasoning-effort",
    `reasoning-effort--${theme}`,
    compact && "reasoning-effort--compact",
  ]}
  aria-label={`Reasoning effort: ${label}`}
>
  <span class="reasoning-effort__copy">
    <span class="reasoning-effort__label">Reasoning effort</span>
    <strong class="reasoning-effort__value">{label}</strong>
  </span>
  <span class="reasoning-effort__meter" aria-hidden="true">
    {
      [1, 2, 3].map((step) => (
        <i class:list={["reasoning-effort__step", step <= activeSteps && "is-active"]}></i>
      ))
    }
  </span>
</span>

<style>
  .reasoning-effort {
    --reasoning-accent: var(--blue);
    --reasoning-border: rgb(17 19 28 / 24%);
    --reasoning-background: rgb(78 100 255 / 5%);
    --reasoning-label: var(--muted);
    display: inline-flex;
    gap: 0.8rem;
    align-items: center;
    min-width: 9.75rem;
    padding: 0.55rem 0.65rem 0.55rem 0.75rem;
    border: 1px solid var(--reasoning-border);
    border-radius: 2px;
    background: var(--reasoning-background);
    line-height: 1;
  }

  .reasoning-effort--dark {
    --reasoning-accent: var(--acid);
    --reasoning-border: rgb(255 255 255 / 24%);
    --reasoning-background: rgb(255 255 255 / 6%);
    --reasoning-label: rgb(255 255 255 / 52%);
    color: white;
  }

  .reasoning-effort__copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.3rem;
  }

  .reasoning-effort__label {
    color: var(--reasoning-label);
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .reasoning-effort__value {
    font-size: 0.77rem;
    font-weight: 800;
    letter-spacing: 0.015em;
  }

  .reasoning-effort__meter {
    display: flex;
    gap: 3px;
    align-items: end;
    height: 1.05rem;
  }

  .reasoning-effort__step {
    display: block;
    width: 4px;
    border: 1px solid var(--reasoning-accent);
    border-radius: 1px 1px 0 0;
    opacity: 0.38;
  }

  .reasoning-effort__step:nth-child(1) {
    height: 45%;
  }

  .reasoning-effort__step:nth-child(2) {
    height: 70%;
  }

  .reasoning-effort__step:nth-child(3) {
    height: 100%;
  }

  .reasoning-effort__step.is-active {
    background: var(--reasoning-accent);
    opacity: 1;
  }

  .reasoning-effort--compact {
    gap: 0.55rem;
    min-width: 0;
    padding: 0.42rem 0.52rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .reasoning-effort--compact .reasoning-effort__copy {
    display: block;
  }

  .reasoning-effort--compact .reasoning-effort__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .reasoning-effort--compact .reasoning-effort__value {
    font-size: 0.68rem;
  }

  .reasoning-effort--compact .reasoning-effort__meter {
    height: 0.85rem;
  }

  .reasoning-effort--compact .reasoning-effort__step {
    width: 3px;
  }
</style>
