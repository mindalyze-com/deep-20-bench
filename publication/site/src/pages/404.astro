---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Not found"
  description="The requested Deep20Bench page could not be found."
>
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>Page not found.</h1>
    <p>This page is not in the current site build.</p>
    <a class="button button-primary" href={base}>Go to results</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 70vh;
    padding: clamp(6rem, 12vw, 11rem) var(--gutter);
    background: var(--ink);
    color: white;
  }

  .not-found h1 {
    max-width: 10ch;
    margin: 0;
    font-family: Iowan Old Style, "Palatino Linotype", Georgia, serif;
    font-size: clamp(3.5rem, 9vw, 8rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .not-found > p:not(.eyebrow) {
    max-width: 40rem;
    margin: 2rem 0;
    color: rgb(255 255 255 / 62%);
    line-height: 1.65;
  }
</style>
