---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import B20Score from "../../../../../components/B20Score.astro";
import ModelUnderTest from "../../../../../components/ModelUnderTest.astro";
import {
  dataset,
  duration,
  money,
  number,
  type PublicRun,
  type PublicSubject,
} from "../../../../../lib/data";

export function getStaticPaths() {
  return dataset.official_runs.flatMap((run) =>
    run.subjects.map((subject) => ({
      params: {
        execution_id: run.execution_id,
        target_id: subject.target_id,
      },
      props: { run, subject },
    })),
  );
}

interface Props {
  run: PublicRun;
  subject: PublicSubject;
}

const { run, subject } = Astro.props;
const base = import.meta.env.BASE_URL;
const subjectDetail = subject.trials.find((trial) => trial.episode)?.episode;
const testedModel = dataset.models.find((model) => model.model_id === run.model_id);

if (!testedModel) {
  throw new Error(`Missing public model metadata for ${run.model_id}`);
}
---

<BaseLayout
  title={`${subject.display_name} · ${run.execution_id}`}
  section="Subject"
  activeNav="Results"
  description={`${subject.display_name} episodes in Deep20Bench run ${run.execution_id}.`}
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={`${base}index.html#leaderboard`}>Results</a><span aria-hidden="true">/</span>
    <a href={`${base}runs/${run.execution_id}/`}>{run.execution_id}</a>
    <span aria-hidden="true">/</span><span aria-current="page">{subject.display_name}</span>
  </nav>

  <ModelUnderTest
    model={testedModel}
    roles={subjectDetail?.models ?? []}
    oracleSupport={subjectDetail?.oracle_support}
  />

  <header class="subject-hero">
    <div class="subject-number" aria-hidden="true">{subject.target_id}</div>
    <div class="subject-title">
      <p class="eyebrow">Hidden subject</p>
      <h1>Finding<br /><em>{subject.display_name}.</em></h1>
    </div>
    <div class="subject-context">
      <p>
        {subjectDetail?.subject_description ??
          `${subject.display_name} was the trusted hidden subject for these episodes.`}
      </p>
      {
        subjectDetail?.subject_reference_url && (
          <a href={subjectDetail.subject_reference_url} target="_blank" rel="noreferrer">
            Subject reference <span aria-hidden="true">↗</span>
          </a>
        )
      }
    </div>
  </header>

  <div class="subject-content">
    <section class="subject-results" aria-label="Subject results">
      <div class="subject-b20-panel">
        <B20Score
          score={subject.b20_score}
          penalizedQuestions={subject.subject_score}
          maxQuestions={run.max_questions}
          explain
        />
        <p>
          B20 is based on the penalized-question mean shown here. Each episode also shows its
          counted and scored questions.
        </p>
      </div>

      <dl class="subject-scorecard">
        <div><dt>Episodes</dt><dd>{subject.trials.length}</dd></div>
        <div><dt>Successful</dt><dd>{subject.successful}</dd></div>
        <div>
          <dt>Penalized questions</dt>
          <dd>{number(subject.subject_score)}</dd>
        </div>
        <div><dt>Entity type</dt><dd>{subject.entity_type.replaceAll("_", " ")}</dd></div>
        <div>
          <dt>Contract compliance</dt>
          <dd>
            {subject.contract.compliance_rate === null
              ? "n/a"
              : `${number(Number(subject.contract.compliance_rate) * 100, 1)}%`}
          </dd>
        </div>
      </dl>
    </section>

    {
      subject.contract.status === "breached" && (
        <section class="contract-alert" aria-label="Output contract reliability warning">
          <div>
            <p class="eyebrow">Reliability warning</p>
            <h2>Model broke the output contract.</h2>
          </div>
          <p>
            {subject.contract.violations} invalid structured{" "}
            {subject.contract.violations === 1 ? "response was" : "responses were"} recorded
            across {subject.contract.affected_trials}{" "}
            {subject.contract.affected_trials === 1 ? "episode" : "episodes"}, with{" "}
            {subject.contract.counted_penalties} counted-turn{" "}
            {subject.contract.counted_penalties === 1 ? "penalty" : "penalties"}. Successful
            episodes remain marked as contract-breached.
          </p>
        </section>
      )
    }

    <section class="episodes" aria-labelledby="episodes-heading">
      <div class="section-intro">
        <div>
          <p class="eyebrow">Episodes</p>
          <h2 id="episodes-heading">Attempts.</h2>
        </div>
        <p>
          Each episode is a separate attempt. Hidden prompts and raw provider messages are not
          published.
        </p>
      </div>
      <div class="episode-list">
        {
          subject.trials.map((trial) => {
            const EpisodeRow = trial.episode ? "a" : "article";
            const episodeHref = trial.episode
              ? `${base}runs/${run.execution_id}/subjects/${subject.target_id}/episodes/${trial.trial_id}/`
              : undefined;

            return (
              <EpisodeRow
                class:list={["episode-row", !trial.episode && "episode-row-disabled"]}
                href={episodeHref}
                aria-label={trial.episode
                  ? `View episode ${trial.trial_number}: ${trial.status.replaceAll("_", " ")}, ${trial.episode.total_turns} turns`
                  : undefined}
              >
                <div class="episode-index">
                  <span>Episode</span>
                  <strong>{String(trial.trial_number).padStart(2, "0")}</strong>
                </div>
                <div class="episode-outcome">
                  <span class:list={["outcome-mark", trial.status]}></span>
                  <div>
                    <p>{trial.status.replaceAll("_", " ")}</p>
                    <strong>
                      {trial.counted_questions} counted{" "}
                      {trial.counted_questions === 1 ? "question" : "questions"}
                    </strong>
                    {
                      trial.contract?.status === "breached" && (
                        <span class="contract-badge">
                          Contract breached · {trial.contract.violations}{" "}
                          {trial.contract.violations === 1 ? "violation" : "violations"}
                        </span>
                      )
                    }
                  </div>
                </div>
                <div class="episode-b20">
                  <B20Score
                    score={trial.b20_score}
                    penalizedQuestions={trial.scored_questions}
                    maxQuestions={run.max_questions}
                    status={trial.status}
                    variant="compact"
                  />
                </div>
                <dl>
                  <div><dt>Duration</dt><dd>{duration(trial.duration_ms)}</dd></div>
                  <div><dt>Episode cost</dt><dd>{money(trial.cost_usd)}</dd></div>
                </dl>
                {
                  trial.episode ? (
                    <span class="episode-action">
                      <span>{trial.episode.total_turns} turns</span>
                      <span class="episode-arrow" aria-hidden="true">→</span>
                    </span>
                  ) : (
                    <span class="episode-action">No completed transcript</span>
                  )
                }
              </EpisodeRow>
            );
          })
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .breadcrumbs {
    display: flex;
    gap: 0.6rem;
    padding: 1rem var(--gutter);
    border-bottom: 1px solid rgb(255 255 255 / 14%);
    background: var(--ink);
    color: rgb(255 255 255 / 52%);
    font-size: 0.7rem;
  }

  @media (max-width: 780px) {
    .breadcrumbs {
      flex-wrap: wrap;
    }
  }

  .subject-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 0.6fr);
    gap: clamp(3rem, 8vw, 8rem);
    margin-top: clamp(2.5rem, 6vw, 5rem);
    padding: clamp(4.5rem, 10vw, 9rem) var(--gutter);
    overflow: hidden;
    background: var(--ink);
    color: white;
  }

  .subject-number {
    position: absolute;
    right: -0.03em;
    bottom: -0.22em;
    color: rgb(255 255 255 / 3.5%);
    font-size: clamp(10rem, 30vw, 34rem);
    font-weight: 850;
    letter-spacing: -0.1em;
    line-height: 1;
  }

  .subject-title,
  .subject-context {
    position: relative;
    z-index: 1;
  }

  .subject-title h1 {
    max-width: 12ch;
    margin: 0;
    font-family: Iowan Old Style, "Palatino Linotype", Georgia, serif;
    font-size: clamp(4rem, 9vw, 9rem);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 0.86;
  }

  .subject-title em {
    color: var(--acid);
    font-weight: inherit;
  }

  .subject-context {
    align-self: end;
    padding-left: 1.4rem;
    border-left: 3px solid var(--acid);
  }

  .subject-context p {
    margin: 0;
    color: rgb(255 255 255 / 68%);
    line-height: 1.7;
  }

  .subject-context a {
    display: inline-block;
    margin-top: 1rem;
    color: var(--acid);
    font-size: 0.77rem;
    font-weight: 700;
  }

  .subject-content {
    padding: clamp(1.5rem, 4vw, 3rem) var(--gutter) clamp(5rem, 10vw, 9rem);
  }

  .subject-content > * {
    width: min(100%, var(--max));
    margin-inline: auto;
  }

  .subject-results {
    overflow: hidden;
    border: 1px solid var(--ink);
    background: var(--paper-bright);
  }

  .subject-b20-panel {
    display: grid;
    grid-template-columns: minmax(17rem, 0.7fr) minmax(0, 1fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: center;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-bottom: 1px solid var(--ink);
    background: var(--paper-bright);
  }

  .subject-b20-panel > p {
    max-width: 38rem;
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .subject-scorecard {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    margin: 0;
    background: var(--acid);
  }

  .subject-scorecard div {
    display: flex;
    min-height: 9rem;
    padding: 1rem;
    border-right: 1px solid var(--ink);
    flex-direction: column;
    justify-content: space-between;
  }

  .subject-scorecard div:last-child {
    border-right: 0;
  }

  .subject-scorecard dt {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .subject-scorecard dd {
    margin: 0;
    font-family: Iowan Old Style, "Palatino Linotype", Georgia, serif;
    font-size: clamp(1.7rem, 4vw, 3.6rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    text-transform: capitalize;
  }

  .contract-alert {
    display: grid;
    grid-template-columns: 0.65fr 1fr;
    gap: clamp(1.5rem, 5vw, 5rem);
    margin-top: 2rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid #c26752;
    background: #fff0eb;
  }

  .contract-alert h2 {
    margin: 0;
    font-family: Iowan Old Style, "Palatino Linotype", Georgia, serif;
    font-size: clamp(2rem, 4.5vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .contract-alert > p {
    margin: 0;
    line-height: 1.7;
  }

  .episodes {
    padding-top: clamp(4rem, 9vw, 8rem);
  }

  .section-intro {
    display: grid;
    grid-template-columns: 1fr 0.55fr;
    gap: 2rem;
    align-items: end;
  }

  .section-intro h2 {
    margin: 0;
    font-family: Iowan Old Style, "Palatino Linotype", Georgia, serif;
    font-size: clamp(3rem, 6vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.055em;
  }

  .section-intro > p {
    max-width: 28rem;
    margin: 0;
    color: var(--muted);
    justify-self: end;
    line-height: 1.65;
  }

  .episode-list {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    border: 1px solid var(--ink);
    background: rgb(251 250 246 / 38%);
  }

  .episode-row {
    position: relative;
    display: grid;
    grid-template-columns:
      minmax(5.25rem, 0.45fr)
      minmax(14rem, 1.2fr)
      minmax(9rem, 0.75fr)
      minmax(10.5rem, 0.75fr)
      auto;
    gap: clamp(0.9rem, 2vw, 1.5rem);
    align-items: center;
    min-height: 7.5rem;
    padding: 1.35rem clamp(1rem, 2vw, 1.5rem);
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
    transition:
      background-color 150ms ease,
      box-shadow 150ms ease;
  }

  .episode-row:last-child {
    border-bottom: 0;
  }

  a.episode-row:hover,
  a.episode-row:focus-visible {
    background: var(--paper-bright);
    box-shadow: inset 4px 0 0 var(--acid);
  }

  a.episode-row:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: -3px;
  }

  .episode-index span {
    display: block;
    color: var(--muted);
    font-size: 0.61rem;
    text-transform: uppercase;
  }

  .episode-index strong {
    display: block;
    margin-top: 0.3rem;
    font-family: Iowan Old Style, "Palatino Linotype", Georgia, serif;
    font-size: 2.6rem;
    font-weight: 500;
  }

  .episode-outcome {
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }

  .outcome-mark {
    width: 0.65rem;
    height: 0.65rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--muted);
  }

  .outcome-mark.success {
    background: #2d8a53;
  }

  .outcome-mark.model_failure,
  .outcome-mark.infrastructure_failure {
    background: var(--coral);
  }

  .episode-outcome p {
    margin: 0 0 0.3rem;
    color: var(--muted);
    font-size: 0.62rem;
    font-weight: 760;
    text-transform: uppercase;
  }

  .episode-outcome strong {
    text-transform: none;
  }

  .contract-badge {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.25rem 0.45rem;
    border: 1px solid #c26752;
    background: #fff0eb;
    color: #803621;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .episode-row dl {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin: 0;
  }

  .episode-row dt {
    color: var(--muted);
    font-size: 0.61rem;
    text-transform: uppercase;
  }

  .episode-row dd {
    margin: 0.35rem 0 0;
    font-variant-numeric: tabular-nums;
  }

  .episode-action {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    justify-self: end;
    min-height: 2.25rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--line);
    background: var(--paper-bright);
    font-size: 0.76rem;
    font-weight: 760;
    text-align: right;
    white-space: nowrap;
  }

  .episode-arrow {
    display: inline-block;
    transition: transform 150ms ease;
  }

  a.episode-row:hover .episode-action,
  a.episode-row:focus-visible .episode-action {
    border-color: var(--ink);
    background: var(--acid);
  }

  a.episode-row:hover .episode-arrow,
  a.episode-row:focus-visible .episode-arrow {
    transform: translateX(0.2rem);
  }

  .episode-row-disabled {
    opacity: 0.55;
  }

  @media (max-width: 820px) {
    .subject-hero,
    .subject-b20-panel,
    .contract-alert,
    .section-intro {
      grid-template-columns: 1fr;
    }

    .subject-scorecard {
      grid-template-columns: 1fr 1fr;
    }

    .subject-scorecard div:nth-child(even) {
      border-right: 0;
    }

    .subject-scorecard div {
      border-bottom: 1px solid var(--ink);
    }

    .subject-scorecard div:last-child {
      grid-column: 1 / -1;
      min-height: 7rem;
      border-bottom: 0;
    }

    .section-intro > p {
      justify-self: start;
    }

    .episode-row {
      grid-template-columns: 3.25rem minmax(0, 1fr);
      gap: 1rem;
      padding: 1.25rem;
    }

    .episode-row dl,
    .episode-b20,
    .episode-action {
      grid-column: 2;
      justify-self: start;
    }

    .episode-action {
      margin-top: 0.2rem;
    }
  }
</style>
