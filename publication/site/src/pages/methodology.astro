---
import BaseLayout from "../layouts/BaseLayout.astro";
import { dataset } from "../lib/data";

const base = import.meta.env.BASE_URL;
const penalty =
  dataset.active_cohort.max_questions + dataset.score_policy.failure_penalty_offset;
const b20Target = dataset.score_policy.b20.target_questions;
const b20Denominator = penalty - b20Target;
---

<BaseLayout
  title="Methodology"
  section="Rules"
  description="The Deep20Bench protocol, score, eligibility rules, and isolation boundary."
>
  <section class="page-hero">
    <div>
      <p class="eyebrow">Methodology</p>
      <h1>How the benchmark works.</h1>
    </div>
    <p>
      A model identifies a hidden subject by asking yes-or-no questions. The publisher scores
      completed runs. It does not rerun or change them.
    </p>
  </section>

  <section class="method-nav" aria-label="Methodology contents">
    <a href="#protocol">01 · Protocol</a>
    <a href="#scoring">02 · Scoring</a>
    <a href="#reliability">03 · Reliability</a>
    <a href="#eligibility">04 · Eligibility</a>
    <a href="#isolation">05 · Isolation</a>
  </section>

  <section class="section method-section" id="protocol">
    <div class="section-inner method-grid">
      <div class="method-index">
        <p class="eyebrow">01 · Protocol</p>
        <p>{dataset.active_cohort.display_name}</p>
      </div>
      <div class="method-copy">
        <h2>Question, answer, guess.</h2>
        <p class="lede">
          The Guesser receives a broad category. It asks questions and receives YES, NO, or
          UNKNOWN.
        </p>
        <div class="fact-grid">
          <div><span>Question limit</span><strong>{dataset.active_cohort.max_questions}</strong></div>
          <div><span>Subjects</span><strong>{dataset.active_cohort.target_ids.length}</strong></div>
          <div><span>Trials / subject</span><strong>{dataset.active_cohort.iterations}</strong></div>
          <div><span>Base seed</span><strong>{dataset.active_cohort.base_seed}</strong></div>
        </div>
        <p>
          The Validator checks the final guess. The Guesser never sees the subject, evidence,
          provider data, or hidden state.
        </p>
        <p>
          If the Guesser breaks the structured-output contract before the limit, the attempt is
          not judged. It loses one counted turn, receives one fixed format reminder that gives
          no right-or-wrong feedback, and may try again.
        </p>
      </div>
    </div>
  </section>

  <section class="section score-section" id="scoring">
    <div class="section-inner method-grid">
      <div class="method-index">
        <p class="eyebrow">02 · Scoring</p>
        <p>{dataset.score_policy.b20.version}</p>
      </div>
      <div class="method-copy">
        <h2>B20 uses 20 as the target.</h2>
        <p class="lede">
          Higher is better. A B20 Score of 20 means 20 penalized questions.
        </p>
        <div class="formula" aria-label="B20 Score formula">
          <div>
            <span>Trial value</span>
            <strong>success: questions · failure: {penalty}</strong>
          </div>
          <div>
            <span>B20 transformation</span>
            <strong>{b20Target} × ({penalty} − P) ÷ {b20Denominator}</strong>
          </div>
          <div>
            <span>Reference points</span>
            <strong>{b20Target} questions → {b20Target} · failure → 0</strong>
          </div>
        </div>
        <p>
          A successful trial uses its counted questions. A model failure gets {penalty}, one
          above the limit. Trials are averaged by subject first, so each subject has equal
          weight. Ranking uses the exact penalized-question value. B20 shows the same order on
          a higher-is-better scale.
        </p>
        <aside>
          <strong>Raw questions are also shown</strong>
          <p>
            Run, subject, and episode pages show counted and penalized questions. Infrastructure
            failures are not scored. B20 is not a percentage.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section method-section" id="reliability">
    <div class="section-inner method-grid">
      <div class="method-index">
        <p class="eyebrow">03 · Reliability</p>
        <p>Independent aspect</p>
      </div>
      <div class="method-copy">
        <h2>Success does not erase a broken contract.</h2>
        <p class="lede">
          Every invalid structured response remains visible, even when the model later finds
          the subject.
        </p>
        <div class="formula">
          <div>
            <span>Turn consequence</span>
            <strong>pre-limit violation → one counted turn</strong>
          </div>
          <div>
            <span>Semantic feedback</span>
            <strong>none · format only</strong>
          </div>
          <div>
            <span>Published measure</span>
            <strong>valid outputs ÷ evaluated outputs</strong>
          </div>
        </div>
        <p>
          Episode, subject, run, and leaderboard pages show compliance, violations, affected
          trials, and counted-turn penalties. These turns already affect the question total, so
          reliability does not add a second B20 penalty.
        </p>
      </div>
    </div>
  </section>

  <section class="section method-section" id="eligibility">
    <div class="section-inner method-grid">
      <div class="method-index">
        <p class="eyebrow">04 · Eligibility</p>
        <p>Official selection</p>
      </div>
      <div class="method-copy">
        <h2>Rules for official results.</h2>
        <p class="lede">
          Completed benchmark evidence is the qualification rule.
        </p>
        <ul class="check-list">
          <li>Run files pass integrity checks.</li>
          <li>The run is terminal and contains every active subject.</li>
          <li>Every subject has all five completed trials, numbered 1 through 5.</li>
          <li>Completed model failures remain valid scored trials.</li>
          <li>A missing or infrastructure-failed trial waits for its retry.</li>
        </ul>
        <p>
          The publisher accepts only the current signed artifact schemas and protocol. If several
          current runs qualify for one model, only the newest completed run is published; the
          best score is not selected. Non-qualifying runs are omitted from the public projection,
          and invalid input stops the build.
        </p>
      </div>
    </div>
  </section>

  <section class="section isolation-section" id="isolation">
    <div class="section-inner method-grid">
      <div class="method-index">
        <p class="eyebrow">05 · Isolation</p>
        <p>Information boundary</p>
      </div>
      <div class="method-copy">
        <h2>The publisher reads completed runs.</h2>
        <div class="flow" aria-label="One-way publication data flow">
          <span>Model calls</span>
          <i aria-hidden="true">→</i>
          <span>Signed artifacts</span>
          <i aria-hidden="true">→</i>
          <span>Public projection</span>
          <i aria-hidden="true">→</i>
          <span>Static site</span>
        </div>
        <p>
          The publisher is a separate package. It reads completed run files and creates the
          public dataset. It does not import the game, Oracle, provider, prompts, credentials,
          sessions, or retry code.
        </p>
        <p>
          Published data never returns to the Guesser. The build needs no API key and makes no
          model calls.
        </p>
        <div class="button-row">
          <a class="button button-secondary" href={`${base}data/`}>View public data →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    display: grid;
    grid-template-columns: 1.2fr 0.65fr;
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
    padding: clamp(5rem, 10vw, 9rem) var(--gutter);
    background: var(--ink);
    color: white;
  }

  .page-hero h1 {
    max-width: 10ch;
    margin: 0;
    font-family: Iowan Old Style, "Palatino Linotype", Georgia, serif;
    font-size: clamp(3.7rem, 8.5vw, 8.5rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.88;
  }

  .page-hero > p {
    margin: 0;
    color: rgb(255 255 255 / 60%);
    line-height: 1.7;
  }

  .method-nav {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border-bottom: 1px solid var(--line);
    background: var(--acid);
  }

  .method-nav a {
    padding: 1.4rem var(--gutter);
    border-right: 1px solid rgb(17 19 28 / 20%);
    font-size: 0.72rem;
    font-weight: 780;
    text-decoration: none;
  }

  .method-nav a:last-child {
    border-right: 0;
  }

  .method-grid {
    display: grid;
    grid-template-columns: minmax(12rem, 0.38fr) minmax(0, 1fr);
    gap: clamp(3rem, 9vw, 9rem);
  }

  .method-index {
    padding-top: 0.5rem;
    border-top: 1px solid var(--ink);
  }

  .method-index p:last-child {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .method-copy {
    max-width: 54rem;
  }

  .method-copy h2 {
    max-width: 11ch;
    margin: 0 0 2rem;
    font-family: Iowan Old Style, "Palatino Linotype", Georgia, serif;
    font-size: clamp(2.7rem, 6vw, 5.8rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }

  .method-copy > p:not(.lede) {
    color: var(--muted);
    line-height: 1.75;
  }

  .fact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 3rem 0;
    border-top: 1px solid var(--ink);
  }

  .fact-grid div {
    display: flex;
    min-height: 8rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
    justify-content: space-between;
    flex-direction: column;
  }

  .fact-grid div:nth-child(odd) {
    padding-right: 1.5rem;
    border-right: 1px solid var(--line);
  }

  .fact-grid div:nth-child(even) {
    padding-left: 1.5rem;
  }

  .fact-grid span,
  .formula span {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 760;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .fact-grid strong {
    font-family: Iowan Old Style, "Palatino Linotype", Georgia, serif;
    font-size: 2.8rem;
    font-weight: 500;
    letter-spacing: -0.05em;
  }

  .score-section {
    background: var(--ink);
    color: white;
  }

  .score-section .method-index {
    border-color: rgb(255 255 255 / 55%);
  }

  .score-section .method-index p:last-child,
  .score-section .method-copy > p:not(.lede) {
    color: rgb(255 255 255 / 58%);
  }

  .formula {
    display: grid;
    margin: 3rem 0;
    border: 1px solid rgb(255 255 255 / 24%);
  }

  .formula div {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding: 1.3rem;
    border-bottom: 1px solid rgb(255 255 255 / 18%);
  }

  .formula div:last-child {
    border-bottom: 0;
    background: var(--acid);
    color: var(--ink);
  }

  .formula strong {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: clamp(0.9rem, 2vw, 1.25rem);
  }

  .method-copy aside {
    margin-top: 3rem;
    padding: 1.5rem;
    border-left: 3px solid var(--coral);
    background: rgb(255 255 255 / 6%);
  }

  .method-copy aside p {
    margin-bottom: 0;
    color: rgb(255 255 255 / 60%);
    line-height: 1.65;
  }

  .check-list {
    display: grid;
    gap: 0;
    margin: 3rem 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .check-list li {
    position: relative;
    padding: 1.15rem 1rem 1.15rem 2.8rem;
    border-bottom: 1px solid var(--line);
    line-height: 1.55;
  }

  .check-list li::before {
    position: absolute;
    top: 1.1rem;
    left: 0;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid var(--blue);
    color: var(--blue);
    font-size: 0.7rem;
    content: "✓";
  }

  .isolation-section {
    background: #dedbd2;
  }

  .flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    gap: 0.6rem;
    align-items: center;
    margin: 2rem 0 3rem;
  }

  .flow span {
    min-height: 5rem;
    padding: 0.8rem;
    border: 1px solid var(--ink);
    display: grid;
    place-items: center;
    font-size: 0.75rem;
    font-weight: 760;
    text-align: center;
  }

  .flow i {
    color: var(--blue);
    font-style: normal;
  }

  @media (max-width: 760px) {
    .page-hero,
    .method-grid {
      grid-template-columns: 1fr;
    }

    .method-nav {
      grid-template-columns: 1fr 1fr;
    }

    .method-nav a:nth-child(even) {
      border-right: 0;
    }

    .method-nav a:nth-child(-n + 4) {
      border-bottom: 1px solid rgb(17 19 28 / 20%);
    }

    .flow {
      grid-template-columns: 1fr;
    }

    .flow i {
      transform: rotate(90deg);
      text-align: center;
    }
  }
</style>
