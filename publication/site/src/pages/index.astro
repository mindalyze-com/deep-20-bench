---
import PublicationChart from "../components/PublicationChart.astro";
import B20Score from "../components/B20Score.astro";
import ReasoningEffort from "../components/ReasoningEffort.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { illustrativeRound } from "../lib/illustrative-round";
import { sourceRepositoryUrl } from "../lib/project-links";
import {
  dataset,
  money,
  number,
  percent,
  reasoningEffortLabel,
} from "../lib/data";

const base = import.meta.env.BASE_URL;
const evaluated = dataset.leaderboard.filter((row) => row.status === "evaluated");
const winnerRows = dataset.winner
  ? dataset.winner.model_ids.flatMap((modelId) => {
      const row = evaluated.find((candidate) => candidate.model.model_id === modelId);
      return row?.execution_id ? [row] : [];
    })
  : [];
const winnerModels = winnerRows.map((row) => row.model);
const leaderboardChart = evaluated.map((row) => ({
  label: row.model.display_name,
  value: Number(row.b20_score),
  detail: `${number(row.b20_score, 1)} B20 · ${number(row.penalized_score)} penalized questions · ${reasoningEffortLabel(row.model.reasoning_effort)} reasoning`,
}));
const totalExpectedTrials =
  dataset.active_cohort.target_ids.length * dataset.active_cohort.iterations;
const b20Target = dataset.score_policy.b20.target_questions;
const failurePenalty =
  dataset.active_cohort.max_questions + dataset.score_policy.failure_penalty_offset;
---

<BaseLayout description={dataset.site.description}>
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-orbit" aria-hidden="true">
      <span class="orbit orbit-one"></span>
      <span class="orbit orbit-two"></span>
      <span class="orbit orbit-three"></span>
      <i class="orbit-dot dot-one"></i>
      <i class="orbit-dot dot-two"></i>
      <i class="orbit-dot dot-three"></i>
      <strong>20</strong>
    </div>
    <div class="hero-main">
      <p class="eyebrow hero-eyebrow">
        <span class="status-dot"></span>
        Deep20Bench · Twenty Questions for LLMs
      </p>
      <h1>Can an LLM ask its way to the answer?</h1>
      <div class="hero-copy">
        <p>
          Twenty Questions is the classic guessing game: one player chooses a hidden person,
          place, or thing; the other may ask only yes-or-no questions.
        </p>
        <p>
          To win, a model needs world knowledge, a question strategy, and the ability to use
          every previous answer. Deep20Bench measures how efficiently it can do that.
        </p>
      </div>
      <div class="button-row">
        <a class="button button-primary" href="#why-it-works">
          How it works <span aria-hidden="true">↓</span>
        </a>
        <a class="button button-secondary" href="#leaderboard">View results</a>
      </div>
    </div>

    <aside class="round-card" aria-label="Illustrative Twenty Questions round">
      <div class="round-card-head">
        <p class="eyebrow">Illustrative round</p>
        <span>Not benchmark data</span>
      </div>
      <div class="round-category">
        <span>Category</span>
        <strong>{illustrativeRound.category}</strong>
      </div>
      <ol>
        {
          illustrativeRound.turns.map((turn, index) => (
            <li class:list={[turn.kind === "guess" && "round-identified"]}>
              <span class="round-number">{String(index + 1).padStart(2, "0")}</span>
              <p>{turn.prompt}</p>
              <strong>{turn.answer}</strong>
            </li>
          ))
        }
      </ol>
      <p class="round-note">
        Each answer should make the next question more useful.
      </p>
    </aside>
  </section>

  <section class="section capability-section" id="why-it-works">
    <div class="section-inner">
      <div class="section-head">
        <div>
          <p class="eyebrow">Why this game works</p>
          <h2>Simple rules. Several abilities.</h2>
        </div>
        <p>
          Playing well means deciding what information is missing, asking for it efficiently,
          and changing course after every answer.
        </p>
      </div>
      <div class="capability-grid">
        <article>
          <span class="ability-number">01</span>
          <span class="ability-icon" aria-hidden="true">◎</span>
          <h3>World knowledge</h3>
          <p>Know which facts, categories, and distinctions are likely to matter.</p>
        </article>
        <article>
          <span class="ability-number">02</span>
          <span class="ability-icon" aria-hidden="true">?</span>
          <h3>Question strategy</h3>
          <p>Choose questions that eliminate many possibilities instead of chasing random facts.</p>
        </article>
        <article>
          <span class="ability-number">03</span>
          <span class="ability-icon" aria-hidden="true">≋</span>
          <h3>State tracking</h3>
          <p>Remember every YES, NO, and UNKNOWN, then use it in the next decision.</p>
        </article>
        <article>
          <span class="ability-number">04</span>
          <span class="ability-icon" aria-hidden="true">✓</span>
          <h3>Decision discipline</h3>
          <p>Make an exact guess within the rules and before the question limit.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section benchmark-section" aria-labelledby="benchmark-title">
    <div class="section-inner benchmark-grid">
      <div class="benchmark-intro">
        <p class="eyebrow">From game to benchmark</p>
        <h2 id="benchmark-title">The same game, made comparable.</h2>
        <p>
          Every model plays behind the same information boundary and every completed run leaves
          a public record.
        </p>
        <a class="button button-secondary" href={`${base}methodology/`}>Read the full method →</a>
      </div>
      <div>
        <ol class="benchmark-steps">
          <li>
            <span>01</span>
            <div>
              <i aria-hidden="true">◉</i>
              <strong>Limited view</strong>
              <p>The model receives a broad category, never the hidden subject.</p>
            </div>
          </li>
          <li>
            <span>02</span>
            <div>
              <i aria-hidden="true">•••</i>
              <strong>One move at a time</strong>
              <p>It submits one structured question or one exact guess.</p>
            </div>
          </li>
          <li>
            <span>03</span>
            <div>
              <i aria-hidden="true">✓ ×</i>
              <strong>Fixed answers</strong>
              <p>A separate adjudication system returns only YES, NO, or UNKNOWN.</p>
            </div>
          </li>
          <li>
            <span>04</span>
            <div>
              <i aria-hidden="true">▁▃▅▇</i>
              <strong>Repeated comparison</strong>
              <p>Subjects have equal weight, and failures remain part of the score.</p>
            </div>
          </li>
        </ol>
        <dl class="benchmark-facts">
          <div>
            <dt>Subjects</dt>
            <dd>{dataset.active_cohort.target_ids.length}</dd>
          </div>
          <div>
            <dt>Trials / subject</dt>
            <dd>{dataset.active_cohort.iterations}</dd>
          </div>
          <div>
            <dt>Trials / model</dt>
            <dd>{totalExpectedTrials}</dd>
          </div>
          <div>
            <dt>Question limit</dt>
            <dd>{dataset.active_cohort.max_questions}</dd>
          </div>
        </dl>
        <p class="benchmark-note">
          Why “Twenty Questions” with a {dataset.active_cohort.max_questions}-question limit?
          The larger ceiling separates slow successes from failures; {b20Target} remains the B20
          reference target.
        </p>
      </div>
    </div>
  </section>

  <section class="section leaderboard-section" id="leaderboard">
    <div class="section-inner">
      <div class="section-head">
        <div>
          <p class="eyebrow">Official results</p>
          <h2>Which models ask best?</h2>
        </div>
        <p>
          Ranking starts with penalized questions: fewer is better. B20 shows the same ordering
          on a higher-is-better scale. B20 {b20Target} means {b20Target} penalized questions; a
          failed trial maps to 0.
        </p>
      </div>

      {
        evaluated.length > 0 ? (
          <>
            {dataset.winner && (
              <div class="leader-card">
                <div>
                  <p class="result-kicker">
                    {dataset.winner.joint ? "Joint official leader" : "Official leader"}
                  </p>
                  <h3>{dataset.winner.display_names.join(" · ")}</h3>
                  <div class="winner-effort">
                    {winnerModels.map((model) => (
                      <ReasoningEffort effort={model.reasoning_effort} theme="dark" />
                    ))}
                  </div>
                  <nav class="winner-links" aria-label="Leader run details">
                    {winnerRows.map((row) => (
                      <a href={`${base}runs/${row.execution_id}/`}>
                        {dataset.winner?.joint ? row.model.display_name : "View full run"}
                        <span aria-hidden="true">→</span>
                      </a>
                    ))}
                  </nav>
                </div>
                <B20Score
                  score={dataset.winner.b20_score}
                  penalizedQuestions={dataset.winner.penalized_score}
                  theme="dark"
                  explain
                />
                <p>
                  Ranked across {evaluated.length} comparable{" "}
                  {evaluated.length === 1 ? "model" : "models"}.
                </p>
              </div>
            )}
            <div class="results-grid">
              <div class="chart-panel">
                <p class="panel-title">Score comparison</p>
                <PublicationChart
                  data={leaderboardChart}
                  kind="leaderboard"
                  label="Official model B20 Scores. Twenty is the target and higher values are better."
                />
              </div>
              <div class="result-metrics">
                <div>
                  <span class="metric-label">Official models</span>
                  <strong class="metric-value">{evaluated.length}</strong>
                </div>
                <div>
                  <span class="metric-label">Trials / model</span>
                  <strong class="metric-value">{totalExpectedTrials}</strong>
                </div>
              </div>
            </div>

            <div class="table-wrap" tabindex="0" aria-label="Scrollable official leaderboard">
              <table class="data-table leaderboard-table">
                <thead>
                  <tr>
                    <th>Rank</th>
                    <th>Model</th>
                    <th>Reasoning effort</th>
                    <th data-numeric>B20 Score</th>
                    <th data-numeric>Success</th>
                    <th data-numeric>Contract compliance</th>
                    <th data-numeric>Run cost</th>
                  </tr>
                </thead>
                <tbody>
                  {evaluated.map((row) => (
                    <tr class="interactive-surface">
                      <td class="rank">{row.rank ? String(row.rank).padStart(2, "0") : "—"}</td>
                      <td>
                        {row.execution_id ? (
                          <a
                            class="leaderboard-run-link stretched-link"
                            href={`${base}runs/${row.execution_id}/`}
                          >
                            <strong>{row.model.display_name}</strong>
                            <span class="row-arrow" aria-hidden="true">→</span>
                          </a>
                        ) : (
                          <strong>{row.model.display_name}</strong>
                        )}
                        <small>{row.model.model_id} · {row.model.provider}</small>
                      </td>
                      <td>
                        <ReasoningEffort effort={row.model.reasoning_effort} compact />
                      </td>
                      <td data-numeric>
                        <B20Score
                          score={row.b20_score}
                          penalizedQuestions={row.penalized_score}
                          showLabel={false}
                          variant="compact"
                        />
                      </td>
                      <td data-numeric>{percent(row.success_rate)}</td>
                      <td data-numeric>
                        {row.contract ? (
                          <>
                            <strong class:list={[row.contract.status === "breached" && "contract-breached"]}>
                              {percent(row.contract.compliance_rate)}
                            </strong>
                            <small>
                              {row.contract.status === "breached"
                                ? `${row.contract.violations} violation${row.contract.violations === 1 ? "" : "s"} · breached`
                                : row.contract.status}
                            </small>
                          </>
                        ) : (
                          "—"
                        )}
                      </td>
                      <td data-numeric>{money(row.total_cost_usd)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <div class="section-link">
              <span>
                Active cohort: <strong>{dataset.active_cohort.display_name}</strong>
              </span>
              <a href={`${base}methodology/`}>Scoring method →</a>
            </div>
          </>
        ) : (
          <>
            <div class="results-grid empty-results-grid">
              <article class="official-empty">
                <div class="empty-chart-grid" aria-hidden="true">
                  <span></span>
                  <span></span>
                  <span></span>
                  <span></span>
                  <span></span>
                  <i></i>
                </div>
                <div class="empty-copy">
                  <p class="panel-title">Score comparison</p>
                  <p class="eyebrow">Current status</p>
                  <h3>Official comparison in progress.</h3>
                  <p>
                    Results appear after a model has a complete, integrity-checked run for
                    every active subject.
                  </p>
                </div>
                <div class="empty-axis" aria-hidden="true">
                  <span>0</span>
                  <span>B20 Score · {b20Target} target · higher is better →</span>
                </div>
              </article>
              <div class="result-metrics">
                <div>
                  <span class="metric-label">Official models</span>
                  <strong class="metric-value">0</strong>
                </div>
                <div>
                  <span class="metric-label">Subjects</span>
                  <strong class="metric-value">{dataset.active_cohort.target_ids.length}</strong>
                </div>
              </div>
            </div>
            <div class="results-ready">
              <dl>
                <div>
                  <dt>Active cohort</dt>
                  <dd>{dataset.active_cohort.display_name}</dd>
                </div>
                <div>
                  <dt>Trials / model</dt>
                  <dd>{totalExpectedTrials}</dd>
                </div>
                <div>
                  <dt>Failure penalty</dt>
                  <dd>{failurePenalty} questions</dd>
                </div>
              </dl>
              <p>
                This space is wired to the published dataset. The chart and ranked table replace
                this status automatically when official runs are available.
              </p>
            </div>
          </>
        )
      }
    </div>
  </section>

  <section class="section trust-section">
    <div class="section-inner">
      <div class="section-head">
        <div>
          <p class="eyebrow">Why trust the comparison</p>
          <h2>Controlled and inspectable.</h2>
        </div>
        <p>
          The score stays compact, while the evidence behind it remains available for closer
          inspection.
        </p>
      </div>
      <div class="trust-grid">
        <article>
          <span>01</span><i aria-hidden="true">▣</i>
          <h3>Strict isolation</h3>
          <p>
            The Guesser sees its category, prior actions, and final answer tokens—not the
            subject or supporting evidence.
          </p>
        </article>
        <article>
          <span>02</span><i aria-hidden="true">◉</i>
          <h3>Failures stay visible</h3>
          <p>
            Failed identifications receive a declared penalty. Invalid structured outputs cost
            turns and remain marked.
          </p>
        </article>
        <article>
          <span>03</span><i aria-hidden="true">◇</i>
          <h3>Every score is inspectable</h3>
          <p>
            Published results link to subjects, episodes, model settings, transcripts, cost,
            and public run data.
          </p>
        </article>
      </div>
      <div class="section-link">
        <span>Completed publication records only.</span>
        <a href={`${base}data/`}>Explore the public data →</a>
      </div>
    </div>
  </section>

  <section class="origin-strip">
    <div>
      <p class="eyebrow">Origin</p>
      <h2>From a holiday game to a benchmark.</h2>
    </div>
    <div>
      <p>
        The idea for Deep20Bench was sparked during a holiday while Patrick Heusser and Markus
        Tuor were playing Twenty Questions with the kids. Inspired by the game, Patrick went on
        to design and build the benchmark from the ground up.
      </p>
      <div class="origin-links">
        <a href={`${base}story/`}>Origin and related research →</a>
        <a
          href="https://machinelearning.apple.com/research/parlor-game-arena"
          target="_blank"
          rel="noreferrer"
        >
          Closest published predecessor ↗
        </a>
      </div>
    </div>
  </section>

  <section class="closing">
    <div>
      <p class="eyebrow">Data and method</p>
      <h2>Inspect the benchmark.</h2>
    </div>
    <div>
      <p>
        Download the public dataset or read the complete scoring and isolation rules.
      </p>
      <div class="button-row">
        <a class="button button-primary" href={`${base}data/`}>Download data</a>
        <a class="button button-secondary" href={`${base}methodology/`}>Read the method</a>
        <a
          class="button button-secondary"
          href={sourceRepositoryUrl}
          target="_blank"
          rel="noreferrer"
        >
          View source ↗
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(20rem, 0.65fr);
    gap: clamp(2rem, 7vw, 7rem);
    padding: clamp(3.5rem, 5vw, 4.75rem) var(--gutter);
    overflow: hidden;
    background: var(--ink);
    color: white;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    opacity: 0.14;
    background-image:
      linear-gradient(rgb(255 255 255 / 25%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 25%) 1px, transparent 1px);
    background-size: 88px 88px;
    mask-image: linear-gradient(to right, black, transparent 70%);
  }

  .hero::after {
    position: absolute;
    right: -6rem;
    bottom: -11rem;
    width: min(40vw, 35rem);
    aspect-ratio: 1;
    border: 1px solid rgb(214 255 63 / 38%);
    border-radius: 50%;
    box-shadow:
      0 0 0 4rem rgb(214 255 63 / 2%),
      0 0 0 8rem rgb(214 255 63 / 2%);
    content: "";
  }

  .hero-orbit {
    position: absolute;
    z-index: 0;
    right: -10rem;
    bottom: -12rem;
    width: min(48vw, 46rem);
    aspect-ratio: 1;
    color: var(--acid);
  }

  .hero-orbit .orbit {
    position: absolute;
    border: 1px solid rgb(214 255 63 / 28%);
    border-radius: 50%;
    inset: 0;
  }

  .hero-orbit .orbit-two {
    inset: 9%;
    border-style: dashed;
  }

  .hero-orbit .orbit-three {
    inset: 19%;
    border-color: rgb(214 255 63 / 58%);
    border-style: dotted;
  }

  .hero-orbit strong {
    position: absolute;
    top: 46%;
    left: 7%;
    display: grid;
    width: 3.1rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 35%);
    border-radius: 50%;
    background: var(--ink);
    font-family: Iowan Old Style, "Palatino Linotype", Georgia, serif;
    font-size: 1.25rem;
    font-weight: 500;
  }

  .orbit-dot {
    position: absolute;
    display: block;
    width: 0.65rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--acid);
  }

  .dot-one {
    top: 4%;
    left: 45%;
  }

  .dot-two {
    top: 34%;
    right: 10%;
    width: 0.42rem;
    opacity: 0.55;
  }

  .dot-three {
    bottom: 16%;
    left: 22%;
    width: 0.46rem;
    opacity: 0.45;
  }

  .hero-main {
    position: relative;
    z-index: 1;
    align-self: center;
  }

  .hero-main {
    max-width: 920px;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--acid);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 4px rgb(214 255 63 / 10%);
  }

  .hero h1 {
    max-width: 11ch;
    margin: 0;
    font-family: Iowan Old Style, "Palatino Linotype", Georgia, serif;
    font-size: clamp(4.1rem, 9.2vw, 9.2rem);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 0.82;
  }

  .hero-copy {
    max-width: 42rem;
    margin: clamp(2rem, 4vw, 3.5rem) 0 0;
    color: rgb(255 255 255 / 68%);
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    line-height: 1.55;
  }

  .result-kicker {
    margin: 0 0 2.4rem;
    color: var(--acid);
    font-size: 0.69rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .winner-effort {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.15rem;
  }

  .winner-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    margin-top: 1.5rem;
  }

  .winner-links a {
    color: var(--acid);
    font-size: 0.76rem;
    font-weight: 760;
    text-decoration: none;
  }

  .winner-links a:hover {
    text-decoration: underline;
  }

  .leaderboard-section {
    background: var(--paper-bright);
  }

  .results-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(13rem, 0.3fr);
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .chart-panel,
  .result-metrics > div {
    border: 1px solid var(--line);
    background: white;
  }

  .chart-panel {
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .panel-title {
    margin: 0 0 1rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .result-metrics {
    display: grid;
    grid-template-rows: 1fr 1fr;
    min-width: 0;
    gap: 1rem;
  }

  .result-metrics > div {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 9rem;
    padding: 1.3rem;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .leaderboard-table {
    min-width: 72rem;
  }

  .leaderboard-table td strong,
  .leaderboard-table td small {
    display: block;
  }

  .leaderboard-table td small {
    margin-top: 0.3rem;
    color: var(--muted);
    font-size: 0.68rem;
  }

  .leaderboard-table tbody tr {
    transition: background-color 150ms ease;
  }

  .leaderboard-table tbody tr:hover,
  .leaderboard-table tbody tr:has(.leaderboard-run-link:focus-visible) {
    background: #eeefff;
  }

  .contract-breached {
    color: #9d3f28;
  }

  .leaderboard-run-link {
    display: inline-flex;
    gap: 0.55rem;
    align-items: center;
    text-decoration: none;
  }

  .leaderboard-table tbody tr:hover .leaderboard-run-link {
    text-decoration: underline;
  }

  .row-arrow {
    color: var(--blue);
    font-weight: 800;
    transition: transform 150ms ease;
  }

  .leaderboard-table tbody tr:hover .row-arrow,
  .leaderboard-run-link:focus-visible .row-arrow {
    transform: translateX(0.2rem);
  }

  .rank {
    color: var(--muted);
    font-family: Iowan Old Style, "Palatino Linotype", Georgia, serif;
    font-size: 1.55rem;
  }

  .section-link {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .section-link a {
    color: var(--ink);
    font-weight: 750;
  }

  .closing {
    display: grid;
